---
import BaseLayout from '../layouts/BaseLayout.astro';
import Waveform from '../components/Waveform.astro';
import i18n from '../../../shared/content/i18n.json';

const lang = 'en';
const t = i18n[lang].music;
const base = import.meta.env.BASE_URL;

const repertoire = [
  // ── NY Piano Society performances ────────────────────────────────────────
  {
    composer: 'Tchaikovsky (arr. Kashkin)',
    works: ['Swan Lake — Finale Scene'],
    note: 'NY Piano Society · Carnegie Hall, March 2025',
  },
  {
    composer: 'Wagner (arr. Liszt)',
    works: ['Tristan und Isolde — Isoldens Liebestod'],
    note: 'NY Piano Society · Kaufman Music Center, October 2024',
  },
  // ── Liszt ────────────────────────────────────────────────────────────────
  {
    composer: 'Liszt',
    works: [
      'Après une lecture du Dante: Fantasia quasi-Sonata',
      'Grandes études de Paganini, S. 141, No. 4 & 5',
    ],
    note: 'Senior Recital · Dickinson College, April 2022',
  },
  // ── Chopin ───────────────────────────────────────────────────────────────
  {
    composer: 'Chopin',
    works: ['Ballade No. 1 in G minor, Op. 23', 'Nocturne in E-flat major, Op. 9 No. 2'],
  },
  // ── Beethoven ────────────────────────────────────────────────────────────
  {
    composer: 'Beethoven',
    works: [
      'Piano Sonata No. 26 in E-flat major, Op. 81a "Les Adieux"',
      'Piano Concerto No. 3 in C minor, Op. 37',
    ],
    note: 'Concerto performed with orchestra · Student Concerto Competition Winner',
  },
  // ── Grieg ────────────────────────────────────────────────────────────────
  {
    composer: 'Grieg',
    works: ['Piano Concerto in A minor, Op. 16'],
    note: 'Performed with orchestra',
  },
  // ── Brahms ───────────────────────────────────────────────────────────────
  {
    composer: 'Brahms',
    works: ['Intermezzo in A major, Op. 118 No. 2'],
  },
  // ── Schubert ─────────────────────────────────────────────────────────────
  {
    composer: 'Schubert',
    works: ['Impromptu in G-flat major, Op. 90 No. 3', 'Impromptu in A-flat major, Op. 90 No. 4'],
  },
  // ── Prokofiev ────────────────────────────────────────────────────────────
  {
    composer: 'Prokofiev',
    works: ['Toccata, Op. 11'],
    note: 'Junior Recital: Desire · Dickinson College, April 2021',
  },
  // ── Debussy ──────────────────────────────────────────────────────────────
  {
    composer: 'Debussy',
    works: ['Préludes (selected)'],
  },
  // ── Mozart ───────────────────────────────────────────────────────────────
  {
    composer: 'Mozart',
    works: ['Piano Concerto No. 24 in C minor, K. 491'],
  },
];
---

<BaseLayout
  title="Music — Ngoc (Ruby) Ngo"
  description="Classical pianist. NY Piano Society. Carnegie Hall and Kaufman Music Center. Romantic era repertoire."
  lang={lang}
>

  <section class="page-hero section section--dark">
    <div class="container">
      <span class="program-label">Music</span>
      <h1>{t.headline}</h1>
      <p class="page-sub">NY Piano Society · Carnegie Hall · Kaufman Music Center</p>
    </div>
  </section>

  <Waveform bars={60} class="section-waveform" />

  <!-- Listen / embed -->
  <section class="section section--cream">
    <div class="container container--narrow">
      <span class="program-label">{t.listen}</span>
      <h2 class="section-h2">Recordings.</h2>
      <div class="embed-placeholder" aria-label="Audio recording — owner to embed YouTube or SoundCloud link">
        <div class="embed-box">
          <p class="embed-note">[ Owner: paste a YouTube or SoundCloud embed here ]</p>
          <p class="embed-note" style="margin-top: var(--space-2); font-size: var(--text-sm);">Replace this block with an <code>&lt;iframe&gt;</code> — see README for instructions.</p>
        </div>
      </div>

      <div class="embed-placeholder" style="margin-top: var(--space-8);" aria-label="Second recording placeholder">
        <div class="embed-box">
          <p class="embed-note">[ Owner: second recording / performance clip ]</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Performance photos -->
  <section class="section section--cream-warm">
    <div class="container">
      <span class="program-label">Performances</span>
      <div class="photos-grid">
        {[1,2,3,4].map(i => (
          <div class="photo-item image-block" style="min-height: 280px;">
            <div class="img-placeholder" style="height:280px; min-height:unset;" aria-label={`Performance photo ${i}`}>photo</div>
          </div>
        ))}
      </div>
      <p class="photos-caption">Carnegie Hall · Kaufman Music Center · NY Piano Society community concerts</p>
    </div>
  </section>

  <!-- Repertoire -->
  <section class="section section--cream">
    <div class="container container--narrow">
      <span class="program-label">{t.program_note}</span>
      <h2 class="section-h2">{t.repertoire_headline}</h2>
      <p class="section-intro">Focused on the Romantic era — the harmonic language that feels most like home.</p>

      <div class="repertoire-list" role="list">
        {repertoire.map(({ composer, works, note }) => (
          <div class="repertoire-group" role="listitem">
            <h3 class="composer-name">{composer}</h3>
            {note && <p class="repertoire-note">{note}</p>}
            <ul class="works-list">
              {works.map(w => <li class="work-item">{w}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Community -->
  <section class="section section--dark">
    <div class="container container--narrow" style="text-align:center;">
      <span class="program-label">Community</span>
      <h2 style="color: var(--color-score-cream); font-weight: 300; letter-spacing: -0.02em; margin-bottom: var(--space-4);">NY Piano Society</h2>
      <p style="color: rgba(245,240,232,0.65); font-style:italic; max-width: 48ch; margin-inline:auto; line-height:1.7;">
        Performing member since 2023. Performing semiannually with the Society's Members across New York City venues.
      </p>
    </div>
  </section>

</BaseLayout>

<style>
.page-hero { padding-top: 120px; }
.page-sub { color: rgba(245,240,232,0.6); margin-top: var(--space-3); font-style:italic; }
.section-waveform { background: var(--color-hall-black); padding: var(--space-3) var(--space-8); }
.section-h2 {
  font-family: var(--font-serif);
  font-size: clamp(var(--text-3xl), 4vw, var(--text-5xl));
  font-weight: 300;
  letter-spacing: -0.03em;
  margin-bottom: var(--space-6);
}
.section-intro {
  color: var(--color-text-muted);
  font-style: italic;
  margin-bottom: var(--space-8);
}

.embed-placeholder {}
.embed-box {
  background: var(--color-cream-warm);
  border: 1px dashed var(--color-cream-mid);
  border-radius: var(--radius-lg);
  padding: var(--space-12) var(--space-8);
  text-align: center;
}
.embed-note {
  color: var(--color-text-muted);
  font-style: italic;
  font-size: var(--text-base);
}

.photos-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--space-4);
  margin-bottom: var(--space-4);
}
.photos-caption {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  text-align: center;
  font-style: italic;
}

.repertoire-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-8);
}
.repertoire-group {}
.composer-name {
  font-family: var(--font-serif);
  font-size: var(--text-2xl);
  font-weight: 400;
  letter-spacing: -0.01em;
  margin-bottom: var(--space-3);
  color: var(--color-text-dark);
}
.works-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  padding-left: var(--space-4);
  border-left: 2px solid var(--color-pearl-dim);
}
.work-item {
  font-size: var(--text-base);
  color: var(--color-text-muted);
  font-style: italic;
}
.repertoire-note {
  font-size: var(--text-xs);
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--color-pearl);
  margin-bottom: var(--space-2);
  max-width: none;
}

@media (max-width: 768px) {
  .photos-grid { grid-template-columns: repeat(2, 1fr); }
}
</style>
