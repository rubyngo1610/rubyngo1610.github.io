---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Waveform from '../../components/Waveform.astro';

const lang = 'en';

// Owner: add .md files to src/content/blog/ and use Astro's content collections
// For the MVP, this is a placeholder page

const placeholderPosts = [
  {
    slug: 'placeholder-1',
    title: '[Post title — owner fills in]',
    date: '2025-01-01',
    summary: 'Placeholder post. Replace with real markdown posts in src/content/blog/.',
  },
];
---

<BaseLayout
  title="Notes — Ngoc (Ruby) Ngo"
  description="Writing on data, music, and the spaces between."
  lang={lang}
>

  <section class="page-hero section section--dark">
    <div class="container">
      <span class="program-label">Notes</span>
      <h1>Writing.</h1>
      <p class="page-sub">Occasional notes on data, music, and the spaces between.</p>
    </div>
  </section>

  <Waveform bars={60} class="section-waveform" />

  <section class="section section--cream">
    <div class="container container--narrow">

      <div class="blog-setup-note">
        <p><strong>Owner note:</strong> Add <code>.md</code> or <code>.mdx</code> files to <code>src/content/blog/</code> and uncomment the content collection loader in this page. See README for instructions.</p>
      </div>

      <ul class="post-list" role="list">
        {placeholderPosts.map(post => (
          <li class="post-item">
            <span class="post-date">{post.date}</span>
            <h2 class="post-title">
              <a href={`#${post.slug}`}>{post.title}</a>
            </h2>
            <p class="post-summary">{post.summary}</p>
          </li>
        ))}
      </ul>

    </div>
  </section>

</BaseLayout>

<style>
.page-hero { padding-top: 120px; }
.page-sub { color: rgba(245,240,232,0.6); margin-top: var(--space-3); font-style:italic; }
.section-waveform { background: var(--color-hall-black); padding: var(--space-3) var(--space-8); }

.blog-setup-note {
  background: var(--color-cream-warm);
  border: 1px solid var(--color-cream-mid);
  border-radius: var(--radius-md);
  padding: var(--space-5) var(--space-6);
  margin-bottom: var(--space-10);
  font-size: var(--text-sm);
  color: var(--color-text-muted);
}
.blog-setup-note code {
  background: rgba(10,10,10,0.07);
  padding: 1px 5px;
  border-radius: 3px;
  font-size: 0.9em;
}

.post-list { list-style: none; display: flex; flex-direction: column; gap: 0; }

.post-item {
  padding-block: var(--space-8);
  border-bottom: 1px solid var(--color-cream-mid);
}
.post-item:last-child { border-bottom: none; }

.post-date {
  font-size: var(--text-xs);
  font-weight: 600;
  letter-spacing: 0.1em;
  color: var(--color-pearl);
  text-transform: uppercase;
  display: block;
  margin-bottom: var(--space-2);
}

.post-title {
  font-family: var(--font-serif);
  font-size: var(--text-2xl);
  font-weight: 400;
  letter-spacing: -0.02em;
  margin-bottom: var(--space-3);
}
.post-title a { color: var(--color-text-dark); }
.post-title a:hover { color: var(--color-pearl); }

.post-summary { font-size: var(--text-base); color: var(--color-text-muted); line-height: 1.7; font-style: italic; }
</style>
