---
import BaseLayout from '../layouts/BaseLayout.astro';
import PianoHero from '../components/PianoHero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import MomentTeaser from '../components/MomentTeaser.astro';
import projects from '../../../shared/content/projects.json';
import momentsData from '../../../shared/data/moments.json';
import i18n from '../../../shared/content/i18n.json';
import metrics from '../../../shared/data/metrics.json';

const lang = 'en';
const t = i18n[lang];
const base = import.meta.env.BASE_URL;

const flagshipIds = [metrics.flagship_projects.primary, metrics.flagship_projects.secondary];
const flagshipProjects = flagshipIds.map(id => projects.find(p => p.id === id)).filter(Boolean);
const topMoments = momentsData.moments.slice(0, 3);
---

<BaseLayout
  title="Ngoc (Ruby) Ngo — Keys of Proof"
  description="Software engineer and classical pianist. White keys = music. Black keys = data. Try one."
  lang={lang}
>

  <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
       HERO — dark stage with piano keyboard
  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
  <section class="piano-stage section section--dark" aria-label="Keys of Proof hero">
    <!-- Scroll-driven waveform bg -->
    <canvas class="stage-canvas" id="stage-canvas" aria-hidden="true"></canvas>

    <div class="stage-content container">
      <div class="stage-headline">
        <span class="program-label">Keys of Proof</span>
        <h1 class="stage-name">{t.hero.name}</h1>
        <p class="stage-tagline">{t.hero.tagline}</p>
      </div>

      <!-- THE PIANO -->
      <PianoHero />

      <!-- Quick CTAs below piano -->
      <div class="stage-ctas cta-group">
        <a href={`/resume.pdf`} class="btn btn--primary" target="_blank" rel="noopener">{t.hero.cta_resume}</a>
        <a href="mailto:ngocrubytin@gmail.com" class="btn btn--outline">{t.hero.cta_email}</a>

        <!-- Inline audio player button -->
        <div class="listen-player" id="listen-player">
          <button class="btn btn--outline listen-btn" id="listen-btn" aria-label="Play piano sample">
            <span class="listen-icon" id="listen-icon" aria-hidden="true">▶</span>
            <span class="listen-label" id="listen-label">{t.hero.cta_listen}</span>
            <span class="eq-bars" id="eq-bars" aria-hidden="true">
              <span class="eq-bar"></span>
              <span class="eq-bar"></span>
              <span class="eq-bar"></span>
              <span class="eq-bar"></span>
              <span class="eq-bar"></span>
            </span>
          </button>
          <audio id="listen-audio" preload="none">
            <source src="/audio/Piano Sonata No. 16 in G Major, Op. 31, no. 1 audio.m4a" type="audio/mp4" />
          </audio>
        </div>
      </div>

      <!-- My Story CTA row -->
      <div class="my-story-row">
        <a href={`/about`} class="btn btn--outline my-story-btn">{t.nav.about}</a>
        <span class="story-arrow" aria-hidden="true">
          <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M8 10 C10 6, 16 4, 18 10 C20 16, 14 22, 18 28" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none"/>
            <path d="M15 24 L18 29 L22 25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          </svg>
        </span>
      </div>
    </div>
  </section>

  <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
       60-SECOND RECRUITER STRIP — same as MVP Program
  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->

  <!-- Moments teasers -->
  <section class="section section--cream-warm" aria-label="Proud moments">
    <div class="container">
      <div class="strip-header">
        <span class="program-label">{t.moments.headline}</span>
        <a href={`/moments`} class="strip-more">All moments →</a>
      </div>
      <div class="carousel carousel--moments">
        <div class="carousel-track">
          {topMoments.map(m => (
            <div class="carousel-slide">
              <MomentTeaser
                id={m.id}
                title={m.title}
                year={m.year}
                category={m.category as 'music' | 'data' | 'both'}
                summary={m.summary_en}
                image={m.image}
                lang={lang}
              />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Flagship projects -->
  <section class="section section--cream" aria-label="Flagship projects">
    <div class="container">
      <div class="strip-header">
        <span class="program-label">Selected work</span>
        <a href={`/projects`} class="strip-more">All projects →</a>
      </div>
      <div class="carousel carousel--projects">
        <div class="carousel-track">
          {flagshipProjects.map((p) => (
            <div class="carousel-slide">
              <ProjectCard
                id={p!.id}
                title={p!.title}
                subtitle={p!.subtitle}
                narrative={p!.narrative}
                tags={p!.tags}
                repo={p!.repo}
                lang={lang}
              />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section section--dark" style="padding-block: var(--space-20);">
    <div class="container" style="text-align:center;">
      <p class="encore-prompt">Open to full-time data engineering · ML engineering · data science roles. NYC-based.</p>
      <div class="cta-group" style="justify-content:center; margin-top:var(--space-6);">
        <a href={`/resume.pdf`} class="btn btn--primary" target="_blank" rel="noopener">{t.hero.cta_resume}</a>
        <a href="mailto:ngocrubytin@gmail.com" class="btn btn--outline">{t.hero.cta_email}</a>
        <a href="https://www.linkedin.com/in/ngocrubyngo" class="btn btn--outline" target="_blank" rel="noopener">LinkedIn</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
/* ─── Piano stage ─── */
.piano-stage {
  position: relative;
  min-height: 100svh;
  display: flex;
  align-items: center;
  overflow: hidden;
}

.stage-canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0.25;
}

.stage-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-8);
  padding-top: 80px;
  padding-bottom: var(--space-16);
}

.stage-headline {
  text-align: center;
}

.stage-name {
  font-family: var(--font-serif);
  font-weight: 300;
  letter-spacing: -0.03em;
  color: var(--color-score-cream);
  line-height: 1.05;
  margin-bottom: var(--space-4);
}

.stage-tagline {
  font-size: clamp(var(--text-base), 1.5vw, var(--text-xl));
  color: rgba(245,240,232,0.65);
  max-width: 52ch;
  line-height: 1.6;
  font-style: italic;
  margin-inline: auto;
}

.stage-ctas { justify-content: center; }

/* ─── My Story row ─── */
.my-story-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-3);
  margin-top: var(--space-2);
}
.my-story-btn {
  font-size: var(--text-sm);
}
.story-arrow {
  color: var(--color-pearl);
  display: flex;
  align-items: center;
  animation: story-bounce 1.6s cubic-bezier(0.34, 1.56, 0.64, 1) infinite;
}
@keyframes story-bounce {
  0%, 100% { transform: translateY(0) rotate(0deg); opacity: 0.7; }
  50%       { transform: translateY(6px) rotate(4deg); opacity: 1; }
}
@media (prefers-reduced-motion: reduce) { .story-arrow { animation: none; } }

/* ─── Listen audio player ─── */
.listen-player { position: relative; }

.listen-btn {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  white-space: nowrap;
  transition:
    width 0.4s cubic-bezier(0.34, 1.56, 0.64, 1),
    background var(--transition),
    border-color var(--transition);
  overflow: hidden;
}

.listen-icon { font-size: 0.7em; line-height: 1; flex-shrink: 0; }

/* Equalizer bars — hidden by default, visible when playing */
.eq-bars {
  display: none;
  align-items: flex-end;
  gap: 2px;
  height: 14px;
  flex-shrink: 0;
}
.listen-btn.is-playing .eq-bars { display: flex; }
.listen-btn.is-playing .listen-label { display: none; }

.eq-bar {
  width: 3px;
  background: var(--color-pearl);
  border-radius: 1px;
  height: 4px;
  transition: height 0.05s linear;
}
/* CSS fallback animation when audio plays but Web Audio API not wired yet */
@keyframes eq-dance-1 { 0%,100%{height:4px} 50%{height:13px} }
@keyframes eq-dance-2 { 0%,100%{height:8px} 50%{height:5px}  }
@keyframes eq-dance-3 { 0%,100%{height:6px} 50%{height:14px} }
@keyframes eq-dance-4 { 0%,100%{height:10px}50%{height:4px}  }
@keyframes eq-dance-5 { 0%,100%{height:3px} 50%{height:11px} }
.listen-btn.is-playing.no-analyser .eq-bar:nth-child(1) { animation: eq-dance-1 0.8s ease-in-out infinite; }
.listen-btn.is-playing.no-analyser .eq-bar:nth-child(2) { animation: eq-dance-2 0.6s ease-in-out infinite 0.1s; }
.listen-btn.is-playing.no-analyser .eq-bar:nth-child(3) { animation: eq-dance-3 0.9s ease-in-out infinite 0.05s; }
.listen-btn.is-playing.no-analyser .eq-bar:nth-child(4) { animation: eq-dance-4 0.7s ease-in-out infinite 0.15s; }
.listen-btn.is-playing.no-analyser .eq-bar:nth-child(5) { animation: eq-dance-5 1.0s ease-in-out infinite 0.2s; }

/* ─── Strip header ─── */
.strip-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: var(--space-8);
}

.strip-more {
  font-size: var(--text-sm);
  font-weight: 500;
  color: var(--color-pearl);
  transition: color var(--transition);
}
.strip-more:hover { color: var(--color-text-dark); }

/* ─── Carousel ─── */
.carousel {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  scroll-snap-type: x mandatory;
  scrollbar-width: none;
}
.carousel::-webkit-scrollbar { display: none; }

.carousel-track {
  display: flex;
  gap: var(--space-6);
}

.carousel-slide {
  flex: 0 0 100%;
  scroll-snap-align: start;
  min-width: 0;
}

@media (min-width: 768px) {
  .carousel--projects .carousel-slide {
    flex: 0 0 calc(50% - var(--space-3));
  }
  .carousel--moments .carousel-slide {
    flex: 0 0 calc(33.333% - var(--space-4));
  }
}

/* ─── Encore ─── */
.encore-prompt {
  font-family: var(--font-serif);
  font-style: italic;
  font-size: clamp(var(--text-xl), 2vw, var(--text-2xl));
  color: rgba(245,240,232,0.7);
  max-width: 52ch;
  margin-inline: auto;
}
</style>

<script>
/* Subtle animated waveform canvas behind the piano */
const canvas = document.getElementById('stage-canvas') as HTMLCanvasElement | null;
if (canvas && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
  const ctx = canvas.getContext('2d')!;
  let t = 0;

  function resize() {
    canvas!.width  = canvas!.offsetWidth;
    canvas!.height = canvas!.offsetHeight;
  }

  function draw() {
    const { width, height } = canvas!;
    ctx.clearRect(0, 0, width, height);
    ctx.strokeStyle = '#7eb8c9';
    ctx.lineWidth = 1;
    ctx.globalAlpha = 0.4;

    for (let wave = 0; wave < 3; wave++) {
      ctx.beginPath();
      for (let x = 0; x <= width; x += 2) {
        const freq = 0.004 + wave * 0.002;
        const amp  = 20 + wave * 8;
        const y = height / 2 + Math.sin(x * freq + t + wave * 1.2) * amp
                             + Math.sin(x * 0.008 + t * 0.7) * 10;
        x === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
      }
      ctx.stroke();
    }

    t += 0.012;
    requestAnimationFrame(draw);
  }

  resize();
  window.addEventListener('resize', resize);
  draw();
}

/* ── Inline audio player ── */
(function () {
  const btn   = document.getElementById('listen-btn') as HTMLButtonElement | null;
  const audio = document.getElementById('listen-audio') as HTMLAudioElement | null;
  const icon  = document.getElementById('listen-icon');
  const label = document.getElementById('listen-label');
  const bars  = document.querySelectorAll<HTMLElement>('.eq-bar');

  if (!btn || !audio) return;

  let audioCtx: AudioContext | null = null;
  let analyser: AnalyserNode | null = null;
  let source: MediaElementAudioSourceNode | null = null;
  let rafId = 0;
  let analyserReady = false;

  function initAudioCtx() {
    if (audioCtx) return;
    try {
      audioCtx = new AudioContext();
      analyser = audioCtx.createAnalyser();
      analyser.fftSize = 64;
      source = audioCtx.createMediaElementSource(audio!);
      source.connect(analyser);
      analyser.connect(audioCtx.destination);
      analyserReady = true;
      btn!.classList.remove('no-analyser');
    } catch {
      btn!.classList.add('no-analyser');
    }
  }

  function animateBars() {
    if (!analyser || !analyserReady) return;
    const data = new Uint8Array(analyser.frequencyBinCount);
    analyser.getByteFrequencyData(data);
    const step = Math.floor(data.length / bars.length);
    bars.forEach((bar, i) => {
      const val = data[i * step] ?? 0;
      bar.style.height = Math.max(3, (val / 255) * 14) + 'px';
    });
    rafId = requestAnimationFrame(animateBars);
  }

  btn.addEventListener('click', async () => {
    if (audio.paused) {
      initAudioCtx();
      if (audioCtx && audioCtx.state === 'suspended') {
        await audioCtx.resume();
      }
      audio.play().catch(() => btn!.classList.add('no-analyser'));
      btn.classList.add('is-playing');
      btn.setAttribute('aria-label', 'Pause piano sample');
      if (icon) icon.textContent = '⏸';
      if (analyserReady) {
        btn.classList.remove('no-analyser');
        animateBars();
      } else {
        btn.classList.add('no-analyser');
      }
    } else {
      audio.pause();
      btn.classList.remove('is-playing');
      btn.setAttribute('aria-label', 'Play piano sample');
      if (icon) icon.textContent = '▶';
      if (label) label.style.display = '';
      cancelAnimationFrame(rafId);
      bars.forEach(bar => { bar.style.height = '4px'; });
    }
  });

  audio.addEventListener('ended', () => {
    btn.classList.remove('is-playing');
    btn.setAttribute('aria-label', 'Play piano sample');
    if (icon) icon.textContent = '▶';
    cancelAnimationFrame(rafId);
    bars.forEach(bar => { bar.style.height = '4px'; });
  });
})();
</script>
