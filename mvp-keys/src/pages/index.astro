---
import BaseLayout from '../layouts/BaseLayout.astro';
import PianoHero from '../components/PianoHero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import MomentTeaser from '../components/MomentTeaser.astro';
import projects from '../../../shared/content/projects.json';
import momentsData from '../../../shared/data/moments.json';
import i18n from '../../../shared/content/i18n.json';
import metrics from '../../../shared/data/metrics.json';

const lang = 'en';
const t = i18n[lang];
const base = import.meta.env.BASE_URL;

const flagshipIds = [metrics.flagship_projects.primary, metrics.flagship_projects.secondary];
const flagshipProjects = flagshipIds.map(id => projects.find(p => p.id === id)).filter(Boolean);
const topMoments = momentsData.moments.slice(0, 3);
---

<BaseLayout
  title="Ngoc (Ruby) Ngo — Keys of Proof"
  description="Software engineer and classical pianist. White keys = music. Black keys = data. Try one."
  lang={lang}
>

  <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
       HERO — dark stage with piano keyboard
  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
  <section class="piano-stage section section--dark" aria-label="Keys of Proof hero">
    <!-- Scroll-driven waveform bg -->
    <canvas class="stage-canvas" id="stage-canvas" aria-hidden="true"></canvas>

    <div class="stage-content container">
      <div class="stage-headline">
        <span class="program-label">Keys of Proof</span>
        <h1 class="stage-name">{t.hero.name}</h1>
        <p class="stage-tagline">{t.hero.tagline}</p>
      </div>

      <!-- THE PIANO -->
      <PianoHero />

      <!-- Quick CTAs below piano -->
      <div class="stage-ctas cta-group">
        <a href={`/resume.pdf`} class="btn btn--primary" target="_blank" rel="noopener">{t.hero.cta_resume}</a>
        <a href="mailto:ngocrubytin@gmail.com" class="btn btn--outline">{t.hero.cta_email}</a>

        <!-- Inline audio player button -->
        <div class="listen-player" id="listen-player">
          <button class="btn btn--outline listen-btn" id="listen-btn" aria-label="Play piano sample">
            <span class="listen-icon" id="listen-icon" aria-hidden="true">▶</span>
            <span class="listen-label" id="listen-label">{t.hero.cta_listen}</span>
            <span class="eq-bars" id="eq-bars" aria-hidden="true">
              <span class="eq-bar"></span>
              <span class="eq-bar"></span>
              <span class="eq-bar"></span>
              <span class="eq-bar"></span>
              <span class="eq-bar"></span>
            </span>
          </button>
          <audio id="listen-audio" preload="none">
            <source src="/audio/Piano%20Sonata%20No.%2016%20in%20G%20Major%2C%20Op.%2031%2C%20no.%201%20audio.m4a" type="audio/mp4" />
          </audio>
        </div>
      </div>

      <!-- My Story CTA — centered frame with arrows pointing in -->
      <div class="my-story-wrap">

        <!-- Arrow: upper-left, sweeps down-right toward frame -->
        <span class="story-arrow story-arrow--tl" aria-hidden="true">
          <svg width="90" height="80" viewBox="0 0 90 80" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="a1" x1="0" y1="0" x2="90" y2="80" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#7eb8c9" stop-opacity="0"/>
                <stop offset="60%" stop-color="#7eb8c9" stop-opacity="0.6"/>
                <stop offset="100%" stop-color="#7eb8c9" stop-opacity="1"/>
              </linearGradient>
            </defs>
            <path d="M8 8 C14 12, 10 24, 18 22 C26 20, 20 10, 28 14 C38 20, 50 40, 66 58 C72 65, 78 70, 82 74"
              stroke="url(#a1)" stroke-width="2" stroke-linecap="round" stroke-dasharray="5 4" fill="none"/>
            <path d="M76 68 L83 75 L75 78" stroke="#7eb8c9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          </svg>
        </span>

        <!-- Arrow: upper-right, sweeps down-left toward frame -->
        <span class="story-arrow story-arrow--tr" aria-hidden="true">
          <svg width="90" height="80" viewBox="0 0 90 80" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="a2" x1="90" y1="0" x2="0" y2="80" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#7eb8c9" stop-opacity="0"/>
                <stop offset="60%" stop-color="#7eb8c9" stop-opacity="0.6"/>
                <stop offset="100%" stop-color="#7eb8c9" stop-opacity="1"/>
              </linearGradient>
            </defs>
            <path d="M82 8 C76 12, 80 24, 72 22 C64 20, 70 10, 62 14 C52 20, 40 40, 24 58 C18 65, 12 70, 8 74"
              stroke="url(#a2)" stroke-width="2" stroke-linecap="round" stroke-dasharray="5 4" fill="none"/>
            <path d="M14 68 L7 75 L15 78" stroke="#7eb8c9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          </svg>
        </span>

        <!-- Arrow: left side, curls in with loop toward frame -->
        <span class="story-arrow story-arrow--l" aria-hidden="true">
          <svg width="80" height="60" viewBox="0 0 80 60" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="a3" x1="0" y1="30" x2="80" y2="30" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#7eb8c9" stop-opacity="0"/>
                <stop offset="50%" stop-color="#7eb8c9" stop-opacity="0.5"/>
                <stop offset="100%" stop-color="#7eb8c9" stop-opacity="1"/>
              </linearGradient>
            </defs>
            <path d="M6 30 C14 20, 22 16, 24 22 C26 28, 18 34, 22 30 C26 26, 34 24, 44 28 C58 34, 68 34, 74 32"
              stroke="url(#a3)" stroke-width="2" stroke-linecap="round" stroke-dasharray="5 4" fill="none"/>
            <path d="M68 27 L75 32 L68 37" stroke="#7eb8c9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          </svg>
        </span>

        <!-- The centered frame -->
        <a href={`/about`} class="my-story-btn" aria-label="My Story — learn about Ruby">
          <span class="my-story-frame">
            <svg class="baroque-ornament baroque-ornament--left" viewBox="0 0 48 60" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M44 30 C38 22, 28 18, 24 10 C20 4, 22 0, 26 2 C30 4, 30 10, 26 14 C22 18, 14 18, 10 24 C6 30, 8 38, 14 40 C20 42, 26 38, 28 32 C30 26, 24 20, 20 24 C16 28, 18 36, 24 36 C30 36, 34 30, 30 26" stroke="url(#goldL)" stroke-width="1.8" stroke-linecap="round" fill="none"/>
              <path d="M44 30 C40 34, 36 40, 30 44 C24 48, 18 46, 14 50 C10 54, 12 58, 16 58 C20 58, 24 54, 22 50 C20 46, 14 46, 12 42" stroke="url(#goldL2)" stroke-width="1.4" stroke-linecap="round" fill="none"/>
              <defs>
                <linearGradient id="goldL" x1="44" y1="30" x2="10" y2="24" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#c9922a"/>
                  <stop offset="40%" stop-color="#f0c96a"/>
                  <stop offset="70%" stop-color="#e8b84a"/>
                  <stop offset="100%" stop-color="#8b5e1a"/>
                </linearGradient>
                <linearGradient id="goldL2" x1="44" y1="30" x2="12" y2="42" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#c9922a"/>
                  <stop offset="50%" stop-color="#f0c96a"/>
                  <stop offset="100%" stop-color="#8b5e1a"/>
                </linearGradient>
              </defs>
            </svg>
            <span class="my-story-text">{t.nav.about}</span>
            <svg class="baroque-ornament baroque-ornament--right" viewBox="0 0 48 60" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M4 30 C10 22, 20 18, 24 10 C28 4, 26 0, 22 2 C18 4, 18 10, 22 14 C26 18, 34 18, 38 24 C42 30, 40 38, 34 40 C28 42, 22 38, 20 32 C18 26, 24 20, 28 24 C32 28, 30 36, 24 36 C18 36, 14 30, 18 26" stroke="url(#goldR)" stroke-width="1.8" stroke-linecap="round" fill="none"/>
              <path d="M4 30 C8 34, 12 40, 18 44 C24 48, 30 46, 34 50 C38 54, 36 58, 32 58 C28 58, 24 54, 26 50 C28 46, 34 46, 36 42" stroke="url(#goldR2)" stroke-width="1.4" stroke-linecap="round" fill="none"/>
              <defs>
                <linearGradient id="goldR" x1="4" y1="30" x2="38" y2="24" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#c9922a"/>
                  <stop offset="40%" stop-color="#f0c96a"/>
                  <stop offset="70%" stop-color="#e8b84a"/>
                  <stop offset="100%" stop-color="#8b5e1a"/>
                </linearGradient>
                <linearGradient id="goldR2" x1="4" y1="30" x2="36" y2="42" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#c9922a"/>
                  <stop offset="50%" stop-color="#f0c96a"/>
                  <stop offset="100%" stop-color="#8b5e1a"/>
                </linearGradient>
              </defs>
            </svg>
          </span>
        </a>

        <!-- Arrow: right side, curls in with loop toward frame -->
        <span class="story-arrow story-arrow--r" aria-hidden="true">
          <svg width="80" height="60" viewBox="0 0 80 60" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="a4" x1="80" y1="30" x2="0" y2="30" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#7eb8c9" stop-opacity="0"/>
                <stop offset="50%" stop-color="#7eb8c9" stop-opacity="0.5"/>
                <stop offset="100%" stop-color="#7eb8c9" stop-opacity="1"/>
              </linearGradient>
            </defs>
            <path d="M74 30 C66 20, 58 16, 56 22 C54 28, 62 34, 58 30 C54 26, 46 24, 36 28 C22 34, 12 34, 6 32"
              stroke="url(#a4)" stroke-width="2" stroke-linecap="round" stroke-dasharray="5 4" fill="none"/>
            <path d="M12 27 L5 32 L12 37" stroke="#7eb8c9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          </svg>
        </span>

        <!-- Arrow: below, sweeps up toward frame -->
        <span class="story-arrow story-arrow--b" aria-hidden="true">
          <svg width="60" height="70" viewBox="0 0 60 70" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="a5" x1="30" y1="70" x2="30" y2="0" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#7eb8c9" stop-opacity="0"/>
                <stop offset="60%" stop-color="#7eb8c9" stop-opacity="0.6"/>
                <stop offset="100%" stop-color="#7eb8c9" stop-opacity="1"/>
              </linearGradient>
            </defs>
            <path d="M30 64 C24 54, 14 46, 16 38 C18 30, 28 30, 26 24 C24 18, 16 18, 20 12 C24 6, 34 8, 32 4"
              stroke="url(#a5)" stroke-width="2" stroke-linecap="round" stroke-dasharray="5 4" fill="none"/>
            <path d="M26 9 L31 2 L37 8" stroke="#7eb8c9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          </svg>
        </span>

      </div>
    </div>
  </section>

  <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
       60-SECOND RECRUITER STRIP — same as MVP Program
  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->

  <!-- Moments teasers -->
  <section class="section section--cream-warm" aria-label="Proud moments">
    <div class="container">
      <div class="strip-header">
        <span class="program-label">{t.moments.headline}</span>
        <a href={`/moments`} class="strip-more">All moments →</a>
      </div>
      <div class="carousel carousel--moments">
        <div class="carousel-track">
          {topMoments.map(m => (
            <div class="carousel-slide">
              <MomentTeaser
                id={m.id}
                title={m.title}
                year={m.year}
                category={m.category as 'music' | 'data' | 'both'}
                summary={m.summary_en}
                image={m.image}
                lang={lang}
              />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Flagship projects -->
  <section class="section section--cream" aria-label="Flagship projects">
    <div class="container">
      <div class="strip-header">
        <span class="program-label">Selected work</span>
        <a href={`/projects`} class="strip-more">All projects →</a>
      </div>
      <div class="carousel carousel--projects">
        <div class="carousel-track">
          {flagshipProjects.map((p) => (
            <div class="carousel-slide">
              <ProjectCard
                id={p!.id}
                title={p!.title}
                subtitle={p!.subtitle}
                narrative={p!.narrative}
                tags={p!.tags}
                repo={p!.repo}
                lang={lang}
              />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section section--dark" style="padding-block: var(--space-20);">
    <div class="container" style="text-align:center;">
      <p class="encore-prompt">Open to full-time data engineering · ML engineering · data science roles. NYC-based.</p>
      <div class="cta-group" style="justify-content:center; margin-top:var(--space-6);">
        <a href={`/resume.pdf`} class="btn btn--primary" target="_blank" rel="noopener">{t.hero.cta_resume}</a>
        <a href="mailto:ngocrubytin@gmail.com" class="btn btn--outline">{t.hero.cta_email}</a>
        <a href="https://www.linkedin.com/in/ngocrubyngo" class="btn btn--outline" target="_blank" rel="noopener">LinkedIn</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
/* ─── Piano stage ─── */
.piano-stage {
  position: relative;
  min-height: 100svh;
  display: flex;
  align-items: center;
  overflow: hidden;
}

.stage-canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0.25;
}

.stage-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-8);
  padding-top: 80px;
  padding-bottom: var(--space-16);
}

.stage-headline {
  text-align: center;
}

.stage-name {
  font-family: var(--font-serif);
  font-weight: 300;
  letter-spacing: -0.03em;
  color: var(--color-score-cream);
  line-height: 1.05;
  margin-bottom: var(--space-4);
}

.stage-tagline {
  font-size: clamp(var(--text-base), 1.5vw, var(--text-xl));
  color: rgba(245,240,232,0.65);
  max-width: 52ch;
  line-height: 1.6;
  font-style: italic;
  margin-inline: auto;
}

.stage-ctas { justify-content: center; }

/* ─── My Story centered wrap ─── */
.my-story-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin-top: var(--space-4);
  /* tall enough for the diagonal arrows above/below */
  padding: 70px 0 60px;
}

/* Baroque gold-frame button — always centered */
.my-story-btn {
  display: inline-flex;
  align-items: center;
  text-decoration: none;
  cursor: pointer;
  transition: transform var(--transition), filter var(--transition);
  position: relative;
  z-index: 1;
}
.my-story-btn:hover { transform: translateY(-1px); filter: brightness(1.12); }
.my-story-btn:focus-visible { outline: 2px solid var(--color-pearl); outline-offset: 4px; border-radius: 4px; }

.my-story-frame {
  display: inline-flex;
  align-items: center;
  gap: 0;
  position: relative;
  padding: var(--space-2) 0;
  background: linear-gradient(135deg, #f5e9c8 0%, #ede0b0 40%, #f0e5c4 70%, #e8d89a 100%);
  border-radius: 6px;
  box-shadow:
    0 0 0 1.5px #b8860b,
    0 0 0 3px #f0c96a,
    0 0 0 4.5px #8b5e1a,
    0 2px 12px rgba(200,150,30,0.25),
    inset 0 1px 3px rgba(255,240,180,0.6);
}

.baroque-ornament { width: 40px; height: 52px; flex-shrink: 0; }
.baroque-ornament--left  { margin-right: -4px; }
.baroque-ornament--right { margin-left: -4px; }

.my-story-text {
  font-family: var(--font-serif);
  font-size: var(--text-base);
  font-weight: 500;
  font-style: italic;
  letter-spacing: 0.06em;
  color: #5a3a00;
  padding: 0 var(--space-5);
  white-space: nowrap;
  text-shadow: 0 1px 2px rgba(255,240,180,0.8);
}

/* Arrows — absolute positioned around the center frame */
.story-arrow {
  position: absolute;
  display: flex;
  pointer-events: none;
}

/* Upper-left: corner pointing down-right */
.story-arrow--tl {
  top: 0; left: calc(50% - 180px);
  animation: arrow-tl 2.2s ease-in-out infinite;
}
/* Upper-right: corner pointing down-left */
.story-arrow--tr {
  top: 0; right: calc(50% - 180px);
  animation: arrow-tr 2.4s ease-in-out infinite 0.3s;
}
/* Left side: sweeping right */
.story-arrow--l {
  left: calc(50% - 230px);
  top: 50%; transform: translateY(-50%);
  animation: arrow-l 2s ease-in-out infinite 0.1s;
}
/* Right side: sweeping left */
.story-arrow--r {
  right: calc(50% - 230px);
  top: 50%; transform: translateY(-50%);
  animation: arrow-r 2.6s ease-in-out infinite 0.5s;
}
/* Bottom: sweeping up */
.story-arrow--b {
  bottom: 0; left: 50%; transform: translateX(-50%);
  animation: arrow-b 1.8s ease-in-out infinite 0.2s;
}

@keyframes arrow-tl { 0%,100%{transform:translate(0,0);opacity:.6} 50%{transform:translate(4px,4px);opacity:1} }
@keyframes arrow-tr { 0%,100%{transform:translate(0,0);opacity:.6} 50%{transform:translate(-4px,4px);opacity:1} }
@keyframes arrow-l  { 0%,100%{transform:translateY(-50%) translateX(0);opacity:.6} 50%{transform:translateY(-50%) translateX(5px);opacity:1} }
@keyframes arrow-r  { 0%,100%{transform:translateY(-50%) translateX(0);opacity:.6} 50%{transform:translateY(-50%) translateX(-5px);opacity:1} }
@keyframes arrow-b  { 0%,100%{transform:translateX(-50%) translateY(0);opacity:.6} 50%{transform:translateX(-50%) translateY(-5px);opacity:1} }

@media (prefers-reduced-motion: reduce) { .story-arrow { animation: none !important; } }

/* Hide side/diagonal arrows on narrow screens to avoid overflow */
@media (max-width: 600px) {
  .story-arrow--tl, .story-arrow--tr, .story-arrow--l, .story-arrow--r { display: none; }
  .my-story-wrap { padding: 20px 0 50px; }
}

/* ─── Listen audio player ─── */
.listen-player { position: relative; }

.listen-btn {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  white-space: nowrap;
  transition:
    width 0.4s cubic-bezier(0.34, 1.56, 0.64, 1),
    background var(--transition),
    border-color var(--transition);
  overflow: hidden;
}

.listen-icon { font-size: 0.7em; line-height: 1; flex-shrink: 0; }

/* Equalizer bars — hidden by default, visible when playing */
.eq-bars {
  display: none;
  align-items: flex-end;
  gap: 2px;
  height: 14px;
  flex-shrink: 0;
}
.listen-btn.is-playing .eq-bars { display: flex; }
.listen-btn.is-playing .listen-label { display: none; }

.eq-bar {
  width: 3px;
  background: var(--color-pearl);
  border-radius: 1px;
  height: 4px;
  transition: height 0.05s linear;
}
/* CSS fallback animation when audio plays but Web Audio API not wired yet */
@keyframes eq-dance-1 { 0%,100%{height:4px} 50%{height:13px} }
@keyframes eq-dance-2 { 0%,100%{height:8px} 50%{height:5px}  }
@keyframes eq-dance-3 { 0%,100%{height:6px} 50%{height:14px} }
@keyframes eq-dance-4 { 0%,100%{height:10px}50%{height:4px}  }
@keyframes eq-dance-5 { 0%,100%{height:3px} 50%{height:11px} }
.listen-btn.is-playing.no-analyser .eq-bar:nth-child(1) { animation: eq-dance-1 0.8s ease-in-out infinite; }
.listen-btn.is-playing.no-analyser .eq-bar:nth-child(2) { animation: eq-dance-2 0.6s ease-in-out infinite 0.1s; }
.listen-btn.is-playing.no-analyser .eq-bar:nth-child(3) { animation: eq-dance-3 0.9s ease-in-out infinite 0.05s; }
.listen-btn.is-playing.no-analyser .eq-bar:nth-child(4) { animation: eq-dance-4 0.7s ease-in-out infinite 0.15s; }
.listen-btn.is-playing.no-analyser .eq-bar:nth-child(5) { animation: eq-dance-5 1.0s ease-in-out infinite 0.2s; }

/* ─── Strip header ─── */
.strip-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: var(--space-8);
}

.strip-more {
  font-size: var(--text-sm);
  font-weight: 500;
  color: var(--color-pearl);
  transition: color var(--transition);
}
.strip-more:hover { color: var(--color-text-dark); }

/* ─── Carousel ─── */
.carousel {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  scroll-snap-type: x mandatory;
  scrollbar-width: none;
}
.carousel::-webkit-scrollbar { display: none; }

.carousel-track {
  display: flex;
  gap: var(--space-6);
}

.carousel-slide {
  flex: 0 0 100%;
  scroll-snap-align: start;
  min-width: 0;
}

@media (min-width: 768px) {
  .carousel--projects .carousel-slide {
    flex: 0 0 calc(50% - var(--space-3));
  }
  .carousel--moments .carousel-slide {
    flex: 0 0 calc(33.333% - var(--space-4));
  }
}

/* ─── Encore ─── */
.encore-prompt {
  font-family: var(--font-serif);
  font-style: italic;
  font-size: clamp(var(--text-xl), 2vw, var(--text-2xl));
  color: rgba(245,240,232,0.7);
  max-width: 52ch;
  margin-inline: auto;
}
</style>

<script>
/* Subtle animated waveform canvas behind the piano */
const canvas = document.getElementById('stage-canvas') as HTMLCanvasElement | null;
if (canvas && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
  const ctx = canvas.getContext('2d')!;
  let t = 0;

  function resize() {
    canvas!.width  = canvas!.offsetWidth;
    canvas!.height = canvas!.offsetHeight;
  }

  function draw() {
    const { width, height } = canvas!;
    ctx.clearRect(0, 0, width, height);
    ctx.strokeStyle = '#7eb8c9';
    ctx.lineWidth = 1;
    ctx.globalAlpha = 0.4;

    for (let wave = 0; wave < 3; wave++) {
      ctx.beginPath();
      for (let x = 0; x <= width; x += 2) {
        const freq = 0.004 + wave * 0.002;
        const amp  = 20 + wave * 8;
        const y = height / 2 + Math.sin(x * freq + t + wave * 1.2) * amp
                             + Math.sin(x * 0.008 + t * 0.7) * 10;
        x === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
      }
      ctx.stroke();
    }

    t += 0.012;
    requestAnimationFrame(draw);
  }

  resize();
  window.addEventListener('resize', resize);
  draw();
}

/* ── Inline audio player ── */
(function () {
  const btn   = document.getElementById('listen-btn') as HTMLButtonElement | null;
  const audio = document.getElementById('listen-audio') as HTMLAudioElement | null;
  const icon  = document.getElementById('listen-icon');
  const label = document.getElementById('listen-label');
  const bars  = document.querySelectorAll<HTMLElement>('.eq-bar');

  if (!btn || !audio) return;

  let audioCtx: AudioContext | null = null;
  let analyser: AnalyserNode | null = null;
  let source: MediaElementAudioSourceNode | null = null;
  let rafId = 0;
  let analyserReady = false;

  function initAudioCtx() {
    if (audioCtx) return;
    try {
      audioCtx = new AudioContext();
      analyser = audioCtx.createAnalyser();
      analyser.fftSize = 64;
      source = audioCtx.createMediaElementSource(audio!);
      source.connect(analyser);
      analyser.connect(audioCtx.destination);
      analyserReady = true;
      btn!.classList.remove('no-analyser');
    } catch {
      btn!.classList.add('no-analyser');
    }
  }

  function animateBars() {
    if (!analyser || !analyserReady) return;
    const data = new Uint8Array(analyser.frequencyBinCount);
    analyser.getByteFrequencyData(data);
    const step = Math.floor(data.length / bars.length);
    bars.forEach((bar, i) => {
      const val = data[i * step] ?? 0;
      bar.style.height = Math.max(3, (val / 255) * 14) + 'px';
    });
    rafId = requestAnimationFrame(animateBars);
  }

  btn.addEventListener('click', async () => {
    if (audio.paused) {
      initAudioCtx();
      if (audioCtx && audioCtx.state === 'suspended') {
        await audioCtx.resume();
      }
      audio.play().catch(() => btn!.classList.add('no-analyser'));
      btn.classList.add('is-playing');
      btn.setAttribute('aria-label', 'Pause piano sample');
      if (icon) icon.textContent = '⏸';
      if (analyserReady) {
        btn.classList.remove('no-analyser');
        animateBars();
      } else {
        btn.classList.add('no-analyser');
      }
    } else {
      audio.pause();
      btn.classList.remove('is-playing');
      btn.setAttribute('aria-label', 'Play piano sample');
      if (icon) icon.textContent = '▶';
      if (label) label.style.display = '';
      cancelAnimationFrame(rafId);
      bars.forEach(bar => { bar.style.height = '4px'; });
    }
  });

  audio.addEventListener('ended', () => {
    btn.classList.remove('is-playing');
    btn.setAttribute('aria-label', 'Play piano sample');
    if (icon) icon.textContent = '▶';
    cancelAnimationFrame(rafId);
    bars.forEach(bar => { bar.style.height = '4px'; });
  });
})();
</script>
