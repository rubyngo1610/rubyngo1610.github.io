---
import BaseLayout from '../layouts/BaseLayout.astro';
import PianoHero from '../components/PianoHero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import MomentTeaser from '../components/MomentTeaser.astro';
import projects from '../../../shared/content/projects.json';
import momentsData from '../../../shared/data/moments.json';
import i18n from '../../../shared/content/i18n.json';
import metrics from '../../../shared/data/metrics.json';

const lang = 'en';
const t = i18n[lang];
const base = import.meta.env.BASE_URL;

const flagshipIds = [metrics.flagship_projects.primary, metrics.flagship_projects.secondary];
const flagshipProjects = flagshipIds.map(id => projects.find(p => p.id === id)).filter(Boolean);
const topMoments = momentsData.moments.slice(0, 3);
---

<BaseLayout
  title="Ngoc (Ruby) Ngo — Keys of Proof"
  description="Software engineer and classical pianist. White keys = music. Black keys = data. Try one."
  lang={lang}
>

  <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
       HERO — dark stage with piano keyboard
  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
  <section class="piano-stage section section--dark" aria-label="Keys of Proof hero">
    <!-- Scroll-driven waveform bg -->
    <canvas class="stage-canvas" id="stage-canvas" aria-hidden="true"></canvas>

    <div class="stage-content container">
      <div class="stage-headline">
        <span class="program-label">Keys of Proof</span>
        <h1 class="stage-name">{t.hero.name}</h1>
        <p class="stage-tagline">{t.hero.tagline}</p>
      </div>

      <!-- THE PIANO -->
      <PianoHero />

      <!-- Quick CTAs below piano -->
      <div class="stage-ctas cta-group">
        <a href={`/resume.pdf`} class="btn btn--primary" target="_blank" rel="noopener">{t.hero.cta_resume}</a>
        <a href="mailto:ngocrubytin@gmail.com" class="btn btn--outline">{t.hero.cta_email}</a>

        <!-- Inline audio player button -->
        <div class="listen-player" id="listen-player">
          <button class="btn btn--outline listen-btn" id="listen-btn" aria-label="Play piano sample">
            <span class="listen-icon" id="listen-icon" aria-hidden="true">▶</span>
            <span class="listen-label" id="listen-label">{t.hero.cta_listen}</span>
            <span class="eq-bars" id="eq-bars" aria-hidden="true">
              <span class="eq-bar"></span>
              <span class="eq-bar"></span>
              <span class="eq-bar"></span>
              <span class="eq-bar"></span>
              <span class="eq-bar"></span>
            </span>
          </button>
          <audio id="listen-audio" preload="none">
            <source src="/audio/Piano%20Sonata%20No.%2016%20in%20G%20Major%2C%20Op.%2031%2C%20no.%201%20audio.m4a" type="audio/mp4" />
          </audio>
        </div>
      </div>

      <!-- My Story CTA — centered frame with sparkles + arrows -->
      <div class="my-story-wrap" aria-hidden="false">

        <!-- Sparkles scattered around the frame -->
        <span class="sparkle sparkle--1" aria-hidden="true">✦</span>
        <span class="sparkle sparkle--2" aria-hidden="true">✦</span>
        <span class="sparkle sparkle--3" aria-hidden="true">+</span>
        <span class="sparkle sparkle--4" aria-hidden="true">·</span>
        <span class="sparkle sparkle--5" aria-hidden="true">✦</span>
        <span class="sparkle sparkle--6" aria-hidden="true">+</span>
        <span class="sparkle sparkle--7" aria-hidden="true">·</span>
        <span class="sparkle sparkle--8" aria-hidden="true">✦</span>
        <span class="sparkle sparkle--9" aria-hidden="true">+</span>
        <span class="sparkle sparkle--10" aria-hidden="true">·</span>

        <!-- Top-left arrow: sweeps from top-left, arrowhead points RIGHT toward frame -->
        <span class="story-arrow story-arrow--tl" aria-hidden="true">
          <svg width="90" height="70" viewBox="0 0 90 70" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="aTL" x1="5" y1="8" x2="82" y2="38" gradientUnits="userSpaceOnUse">
                <stop offset="0%"   stop-color="#7eb8c9" stop-opacity="0"/>
                <stop offset="50%"  stop-color="#7eb8c9" stop-opacity="0.6"/>
                <stop offset="100%" stop-color="#7eb8c9" stop-opacity="1"/>
              </linearGradient>
            </defs>
            <path d="M 5 8 C 25 -2, 60 12, 46 34 C 38 50, 18 50, 24 38 C 30 26, 55 28, 80 38"
              stroke="url(#aTL)" stroke-width="2.4" stroke-linecap="round" fill="none"/>
            <path d="M 74 32 L 82 38 L 74 45"
              stroke="#7eb8c9" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          </svg>
        </span>

        <!-- The centered frame -->
        <a href={`/about`} class="my-story-btn" aria-label="My Story — learn about Ruby">
          <span class="my-story-frame">
            <svg class="baroque-ornament baroque-ornament--left" viewBox="0 0 48 60" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M44 30 C38 22, 28 18, 24 10 C20 4, 22 0, 26 2 C30 4, 30 10, 26 14 C22 18, 14 18, 10 24 C6 30, 8 38, 14 40 C20 42, 26 38, 28 32 C30 26, 24 20, 20 24 C16 28, 18 36, 24 36 C30 36, 34 30, 30 26" stroke="url(#goldL)" stroke-width="1.8" stroke-linecap="round" fill="none"/>
              <path d="M44 30 C40 34, 36 40, 30 44 C24 48, 18 46, 14 50 C10 54, 12 58, 16 58 C20 58, 24 54, 22 50 C20 46, 14 46, 12 42" stroke="url(#goldL2)" stroke-width="1.4" stroke-linecap="round" fill="none"/>
              <defs>
                <linearGradient id="goldL" x1="44" y1="30" x2="10" y2="24" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#c9922a"/><stop offset="40%" stop-color="#f0c96a"/>
                  <stop offset="70%" stop-color="#e8b84a"/><stop offset="100%" stop-color="#8b5e1a"/>
                </linearGradient>
                <linearGradient id="goldL2" x1="44" y1="30" x2="12" y2="42" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#c9922a"/><stop offset="50%" stop-color="#f0c96a"/>
                  <stop offset="100%" stop-color="#8b5e1a"/>
                </linearGradient>
              </defs>
            </svg>
            <span class="my-story-text">
              <span class="my-story-title">{t.nav.about}</span>
              <span class="my-story-subtitle">(in data language)</span>
            </span>
            <svg class="baroque-ornament baroque-ornament--right" viewBox="0 0 48 60" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M4 30 C10 22, 20 18, 24 10 C28 4, 26 0, 22 2 C18 4, 18 10, 22 14 C26 18, 34 18, 38 24 C42 30, 40 38, 34 40 C28 42, 22 38, 20 32 C18 26, 24 20, 28 24 C32 28, 30 36, 24 36 C18 36, 14 30, 18 26" stroke="url(#goldR)" stroke-width="1.8" stroke-linecap="round" fill="none"/>
              <path d="M4 30 C8 34, 12 40, 18 44 C24 48, 30 46, 34 50 C38 54, 36 58, 32 58 C28 58, 24 54, 26 50 C28 46, 34 46, 36 42" stroke="url(#goldR2)" stroke-width="1.4" stroke-linecap="round" fill="none"/>
              <defs>
                <linearGradient id="goldR" x1="4" y1="30" x2="38" y2="24" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#c9922a"/><stop offset="40%" stop-color="#f0c96a"/>
                  <stop offset="70%" stop-color="#e8b84a"/><stop offset="100%" stop-color="#8b5e1a"/>
                </linearGradient>
                <linearGradient id="goldR2" x1="4" y1="30" x2="36" y2="42" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#c9922a"/><stop offset="50%" stop-color="#f0c96a"/>
                  <stop offset="100%" stop-color="#8b5e1a"/>
                </linearGradient>
              </defs>
            </svg>
          </span>
        </a>

        <!-- Bottom-right arrow: sweeps from bottom-right, arrowhead points LEFT toward frame -->
        <span class="story-arrow story-arrow--br" aria-hidden="true">
          <svg width="90" height="70" viewBox="0 0 90 70" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="aBR" x1="85" y1="62" x2="8" y2="32" gradientUnits="userSpaceOnUse">
                <stop offset="0%"   stop-color="#7eb8c9" stop-opacity="0"/>
                <stop offset="50%"  stop-color="#7eb8c9" stop-opacity="0.6"/>
                <stop offset="100%" stop-color="#7eb8c9" stop-opacity="1"/>
              </linearGradient>
            </defs>
            <path d="M 85 62 C 65 72, 30 58, 44 36 C 52 20, 72 20, 66 32 C 60 44, 35 42, 10 32"
              stroke="url(#aBR)" stroke-width="2.4" stroke-linecap="round" fill="none"/>
            <path d="M 16 26 L 8 32 L 16 39"
              stroke="#7eb8c9" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          </svg>
        </span>

      </div>
    </div>
  </section>

  <!-- Scroll cue — fixed to viewport bottom-center, disappears on scroll -->
  <button class="scroll-cue" id="scroll-cue" aria-label="Scroll down" tabindex="-1">
    <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
      <path d="M6 10 L14 18 L22 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>

  <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
       60-SECOND RECRUITER STRIP — same as MVP Program
  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->

  <!-- Moments teasers -->
  <section class="section section--cream-warm" aria-label="Proud moments">
    <div class="container">
      <div class="strip-header">
        <span class="program-label">{t.moments.headline}</span>
        <a href={`/moments`} class="strip-more">All moments →</a>
      </div>
      <div class="carousel carousel--moments">
        <div class="carousel-track">
          {topMoments.map(m => (
            <div class="carousel-slide">
              <MomentTeaser
                id={m.id}
                title={m.title}
                year={m.year}
                category={m.category as 'music' | 'data' | 'both'}
                summary={m.summary_en}
                image={m.image}
                lang={lang}
              />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Flagship projects -->
  <section class="section section--cream" aria-label="Flagship projects">
    <div class="container">
      <div class="strip-header">
        <span class="program-label">Selected work</span>
        <a href={`/projects`} class="strip-more">All projects →</a>
      </div>
      <div class="carousel carousel--projects">
        <div class="carousel-track">
          {flagshipProjects.map((p) => (
            <div class="carousel-slide">
              <ProjectCard
                id={p!.id}
                title={p!.title}
                subtitle={p!.subtitle}
                narrative={p!.narrative}
                tags={p!.tags}
                repo={p!.repo}
                lang={lang}
              />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section section--dark" style="padding-block: var(--space-20);">
    <div class="container" style="text-align:center;">
      <p class="encore-prompt">Open to full-time data engineering · ML engineering · data science roles. NYC-based.</p>
    </div>
  </section>

</BaseLayout>

<style>
/* ─── Piano stage ─── */
.piano-stage {
  position: relative;
  min-height: 100svh;
  display: flex;
  align-items: center;
  overflow: hidden;
}

.stage-canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0.25;
}

.stage-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-8);
  padding-top: 80px;
  padding-bottom: var(--space-16);
}

.stage-headline {
  text-align: center;
}

.stage-name {
  font-family: var(--font-serif);
  font-weight: 300;
  letter-spacing: -0.03em;
  color: var(--color-score-cream);
  line-height: 1.05;
  margin-bottom: var(--space-4);
}

.stage-tagline {
  font-size: clamp(var(--text-base), 1.5vw, var(--text-xl));
  color: rgba(245,240,232,0.65);
  max-width: 52ch;
  line-height: 1.6;
  font-style: italic;
  margin-inline: auto;
}

.stage-ctas { justify-content: center; }

/* ─── Scroll cue ─── */
.scroll-cue {
  position: fixed;
  bottom: var(--space-8);
  left: 50%;
  transform: translateX(-50%);
  background: none;
  border: none;
  color: var(--color-pearl);
  opacity: 0;
  cursor: default;
  padding: var(--space-2);
  z-index: var(--z-above);
  pointer-events: none;
  animation:
    cue-appear 0.6s ease-out 1.5s forwards,
    cue-float  2.6s ease-in-out 2.1s infinite;
  transition: opacity 0.5s ease;
}
.scroll-cue.is-hidden {
  opacity: 0 !important;
  animation: none;
}
@keyframes cue-appear {
  to { opacity: 0.45; }
}
@keyframes cue-float {
  0%, 100% { transform: translateX(-50%) translateY(0); }
  50%       { transform: translateX(-50%) translateY(7px); }
}
@media (prefers-reduced-motion: reduce) {
  .scroll-cue { animation: cue-appear 0.6s ease-out 1.5s forwards; }
}

/* ─── My Story centered wrap ─── */
.my-story-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin-top: var(--space-4);
  padding: 48px 80px;
}

/* Baroque gold-frame button — static, no heartbeat */
.my-story-btn {
  display: inline-flex;
  align-items: center;
  text-decoration: none;
  cursor: pointer;
  transition: transform var(--transition), filter var(--transition);
  position: relative;
  z-index: 1;
}
.my-story-btn:hover  { transform: translateY(-1px); filter: brightness(1.12); }
.my-story-btn:focus-visible { outline: 2px solid var(--color-pearl); outline-offset: 4px; border-radius: 4px; }

/* ─── Sweeping arrows ─── */
.story-arrow {
  position: absolute;
  display: flex;
  pointer-events: none;
  animation: arrow-heartbeat 1.8s ease-in-out infinite;
}
/* top-left arrow: sits above-left of the frame, arrowhead points down-right */
.story-arrow--tl {
  left: calc(50% - 230px);
  top: calc(50% - 80px);
  animation-delay: 0.1s;
}
/* bottom-right arrow: sits below-right of the frame, arrowhead points up-left */
.story-arrow--br {
  right: calc(50% - 230px);
  bottom: calc(50% - 80px);
  animation-delay: 0.45s;
}

@keyframes arrow-heartbeat {
  0%   { opacity: 0.55; transform: scale(1);    }
  14%  { opacity: 1;    transform: scale(1.1);  }
  28%  { opacity: 0.7;  transform: scale(0.97); }
  42%  { opacity: 0.95; transform: scale(1.05); }
  70%  { opacity: 0.55; transform: scale(1);    }
  100% { opacity: 0.55; transform: scale(1);    }
}

.my-story-frame {
  display: inline-flex;
  align-items: center;
  gap: 0;
  position: relative;
  padding: var(--space-2) 0;
  background: linear-gradient(135deg, #f5e9c8 0%, #ede0b0 40%, #f0e5c4 70%, #e8d89a 100%);
  border-radius: 6px;
  box-shadow:
    0 0 0 1.5px #b8860b,
    0 0 0 3px #f0c96a,
    0 0 0 4.5px #8b5e1a,
    0 2px 12px rgba(200,150,30,0.25),
    inset 0 1px 3px rgba(255,240,180,0.6);
}

.baroque-ornament { width: 40px; height: 52px; flex-shrink: 0; }
.baroque-ornament--left  { margin-right: -4px; }
.baroque-ornament--right { margin-left: -4px; }

.my-story-text {
  font-family: var(--font-serif);
  letter-spacing: 0.06em;
  color: #5a3a00;
  padding: 0 var(--space-5);
  text-shadow: 0 1px 2px rgba(255,240,180,0.8);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1px;
}
.my-story-title {
  font-size: var(--text-base);
  font-weight: 500;
  font-style: italic;
}
.my-story-subtitle {
  font-size: 0.7em;
  font-weight: 400;
  font-style: italic;
  opacity: 0.75;
  letter-spacing: 0.04em;
}

/* ─── Sparkles ─── */
.sparkle {
  position: absolute;
  color: var(--color-pearl);
  pointer-events: none;
  font-style: normal;
  line-height: 1;
  animation: sparkle-beat 1.8s ease-in-out infinite;
}

/* Position each sparkle around the frame */
.sparkle--1  { top: 4px;  left: calc(50% - 130px); font-size: 14px; animation-delay: 0s;     }
.sparkle--2  { top: 2px;  left: calc(50% + 100px);  font-size: 10px; animation-delay: 0.3s;   }
.sparkle--3  { top: 12px; left: calc(50% - 170px);  font-size: 12px; animation-delay: 0.6s;   }
.sparkle--4  { top: 20px; left: calc(50% + 150px);  font-size: 8px;  animation-delay: 0.1s;   }
.sparkle--5  { bottom: 6px;  left: calc(50% - 110px); font-size: 12px; animation-delay: 0.45s; }
.sparkle--6  { bottom: 4px;  left: calc(50% + 90px);  font-size: 10px; animation-delay: 0.9s;  }
.sparkle--7  { top: 50%; left: calc(50% - 200px); transform: translateY(-50%); font-size: 7px; animation-delay: 0.2s; }
.sparkle--8  { top: 50%; left: calc(50% + 170px); transform: translateY(-50%); font-size: 13px; animation-delay: 0.7s; }
.sparkle--9  { top: 8px; left: calc(50% - 10px);  font-size: 9px;  animation-delay: 0.55s;  }
.sparkle--10 { bottom: 8px; left: calc(50% + 20px); font-size: 7px; animation-delay: 1.1s;   }

@keyframes sparkle-beat {
  0%   { transform: scale(1)    rotate(0deg);   opacity: 0.5; }
  14%  { transform: scale(1.5)  rotate(15deg);  opacity: 1;   }
  28%  { transform: scale(0.9)  rotate(-5deg);  opacity: 0.6; }
  42%  { transform: scale(1.25) rotate(10deg);  opacity: 0.9; }
  70%  { transform: scale(1)    rotate(0deg);   opacity: 0.5; }
  100% { transform: scale(1)    rotate(0deg);   opacity: 0.5; }
}
/* Fix sparkles that use translateY for centering — include it in the keyframe */
.sparkle--7 { animation-name: sparkle-beat-mid; }
.sparkle--8 { animation-name: sparkle-beat-mid; }
@keyframes sparkle-beat-mid {
  0%   { transform: translateY(-50%) scale(1)    rotate(0deg);  opacity: 0.5; }
  14%  { transform: translateY(-50%) scale(1.5)  rotate(15deg); opacity: 1;   }
  28%  { transform: translateY(-50%) scale(0.9)  rotate(-5deg); opacity: 0.6; }
  42%  { transform: translateY(-50%) scale(1.25) rotate(10deg); opacity: 0.9; }
  70%  { transform: translateY(-50%) scale(1)    rotate(0deg);  opacity: 0.5; }
  100% { transform: translateY(-50%) scale(1)    rotate(0deg);  opacity: 0.5; }
}

@media (prefers-reduced-motion: reduce) {
  .sparkle, .story-arrow { animation: none !important; }
}
@media (max-width: 640px) {
  .my-story-wrap { padding: 60px 16px; }
  .story-arrow--tl { left: calc(50% - 160px); top: 0; }
  .story-arrow--br { right: calc(50% - 160px); bottom: 0; }
  .sparkle--3, .sparkle--7, .sparkle--8 { display: none; }
}

/* ─── Listen audio player ─── */
.listen-player { position: relative; }

.listen-btn {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  white-space: nowrap;
  transition:
    width 0.4s cubic-bezier(0.34, 1.56, 0.64, 1),
    background var(--transition),
    border-color var(--transition);
  overflow: hidden;
}

.listen-icon { font-size: 0.7em; line-height: 1; flex-shrink: 0; }

/* Equalizer bars — hidden by default, visible when playing */
.eq-bars {
  display: none;
  align-items: flex-end;
  gap: 2px;
  height: 14px;
  flex-shrink: 0;
}
.listen-btn.is-playing .eq-bars { display: flex; }
.listen-btn.is-playing .listen-label { display: none; }

.eq-bar {
  width: 3px;
  background: var(--color-pearl);
  border-radius: 1px;
  height: 4px;
  transition: height 0.05s linear;
}
/* CSS fallback animation when audio plays but Web Audio API not wired yet */
@keyframes eq-dance-1 { 0%,100%{height:4px} 50%{height:13px} }
@keyframes eq-dance-2 { 0%,100%{height:8px} 50%{height:5px}  }
@keyframes eq-dance-3 { 0%,100%{height:6px} 50%{height:14px} }
@keyframes eq-dance-4 { 0%,100%{height:10px}50%{height:4px}  }
@keyframes eq-dance-5 { 0%,100%{height:3px} 50%{height:11px} }
.listen-btn.is-playing.no-analyser .eq-bar:nth-child(1) { animation: eq-dance-1 0.8s ease-in-out infinite; }
.listen-btn.is-playing.no-analyser .eq-bar:nth-child(2) { animation: eq-dance-2 0.6s ease-in-out infinite 0.1s; }
.listen-btn.is-playing.no-analyser .eq-bar:nth-child(3) { animation: eq-dance-3 0.9s ease-in-out infinite 0.05s; }
.listen-btn.is-playing.no-analyser .eq-bar:nth-child(4) { animation: eq-dance-4 0.7s ease-in-out infinite 0.15s; }
.listen-btn.is-playing.no-analyser .eq-bar:nth-child(5) { animation: eq-dance-5 1.0s ease-in-out infinite 0.2s; }

/* ─── Strip header ─── */
.strip-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: var(--space-8);
}

.strip-more {
  font-size: var(--text-sm);
  font-weight: 500;
  color: var(--color-pearl);
  transition: color var(--transition);
}
.strip-more:hover { color: var(--color-text-dark); }

/* ─── Carousel ─── */
.carousel {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  scroll-snap-type: x mandatory;
  scrollbar-width: none;
}
.carousel::-webkit-scrollbar { display: none; }

.carousel-track {
  display: flex;
  gap: var(--space-6);
}

.carousel-slide {
  flex: 0 0 100%;
  scroll-snap-align: start;
  min-width: 0;
}

@media (min-width: 768px) {
  .carousel--projects .carousel-slide {
    flex: 0 0 calc(50% - var(--space-3));
  }
  .carousel--moments .carousel-slide {
    flex: 0 0 calc(33.333% - var(--space-4));
  }
}

/* ─── Encore ─── */
.encore-prompt {
  font-family: var(--font-serif);
  font-style: italic;
  font-size: clamp(var(--text-xl), 2vw, var(--text-2xl));
  color: rgba(245,240,232,0.7);
  max-width: 52ch;
  margin-inline: auto;
}
</style>

<script>
/* Subtle animated waveform canvas behind the piano */
const canvas = document.getElementById('stage-canvas') as HTMLCanvasElement | null;
if (canvas && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
  const ctx = canvas.getContext('2d')!;
  let t = 0;

  function resize() {
    canvas!.width  = canvas!.offsetWidth;
    canvas!.height = canvas!.offsetHeight;
  }

  function draw() {
    const { width, height } = canvas!;
    ctx.clearRect(0, 0, width, height);
    ctx.strokeStyle = '#7eb8c9';
    ctx.lineWidth = 1;
    ctx.globalAlpha = 0.4;

    for (let wave = 0; wave < 3; wave++) {
      ctx.beginPath();
      for (let x = 0; x <= width; x += 2) {
        const freq = 0.004 + wave * 0.002;
        const amp  = 20 + wave * 8;
        const y = height / 2 + Math.sin(x * freq + t + wave * 1.2) * amp
                             + Math.sin(x * 0.008 + t * 0.7) * 10;
        x === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
      }
      ctx.stroke();
    }

    t += 0.012;
    requestAnimationFrame(draw);
  }

  resize();
  window.addEventListener('resize', resize);
  draw();
}

/* ── Scroll cue ── */
(function () {
  const cue = document.getElementById('scroll-cue');
  if (!cue) return;
  const hide = () => { if (window.scrollY > 80) cue.classList.add('is-hidden'); };
  window.addEventListener('scroll', hide, { passive: true });
})();

/* ── Inline audio player ── */
(function () {
  const btn   = document.getElementById('listen-btn') as HTMLButtonElement | null;
  const audio = document.getElementById('listen-audio') as HTMLAudioElement | null;
  const icon  = document.getElementById('listen-icon');
  const label = document.getElementById('listen-label');
  const bars  = document.querySelectorAll<HTMLElement>('.eq-bar');

  if (!btn || !audio) return;

  let audioCtx: AudioContext | null = null;
  let analyser: AnalyserNode | null = null;
  let source: MediaElementAudioSourceNode | null = null;
  let rafId = 0;
  let analyserReady = false;

  function initAudioCtx() {
    if (audioCtx) return;
    try {
      audioCtx = new AudioContext();
      analyser = audioCtx.createAnalyser();
      analyser.fftSize = 64;
      source = audioCtx.createMediaElementSource(audio!);
      source.connect(analyser);
      analyser.connect(audioCtx.destination);
      analyserReady = true;
      btn!.classList.remove('no-analyser');
    } catch {
      btn!.classList.add('no-analyser');
    }
  }

  function animateBars() {
    if (!analyser || !analyserReady) return;
    const data = new Uint8Array(analyser.frequencyBinCount);
    analyser.getByteFrequencyData(data);
    const step = Math.floor(data.length / bars.length);
    bars.forEach((bar, i) => {
      const val = data[i * step] ?? 0;
      bar.style.height = Math.max(3, (val / 255) * 14) + 'px';
    });
    rafId = requestAnimationFrame(animateBars);
  }

  btn.addEventListener('click', async () => {
    if (audio.paused) {
      initAudioCtx();
      if (audioCtx && audioCtx.state === 'suspended') {
        await audioCtx.resume();
      }
      audio.play().catch(() => btn!.classList.add('no-analyser'));
      btn.classList.add('is-playing');
      btn.setAttribute('aria-label', 'Pause piano sample');
      if (icon) icon.textContent = '⏸';
      if (analyserReady) {
        btn.classList.remove('no-analyser');
        animateBars();
      } else {
        btn.classList.add('no-analyser');
      }
    } else {
      audio.pause();
      btn.classList.remove('is-playing');
      btn.setAttribute('aria-label', 'Play piano sample');
      if (icon) icon.textContent = '▶';
      if (label) label.style.display = '';
      cancelAnimationFrame(rafId);
      bars.forEach(bar => { bar.style.height = '4px'; });
    }
  });

  audio.addEventListener('ended', () => {
    btn.classList.remove('is-playing');
    btn.setAttribute('aria-label', 'Play piano sample');
    if (icon) icon.textContent = '▶';
    cancelAnimationFrame(rafId);
    bars.forEach(bar => { bar.style.height = '4px'; });
  });
})();
</script>
