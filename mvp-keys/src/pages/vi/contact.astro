---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Waveform from '../../components/Waveform.astro';
import i18n from '../../../../shared/content/i18n.json';

const lang = 'vi';
const t = i18n[lang].contact;
---

<BaseLayout
  title="Liên Hệ — Ngô Ngọc (Ruby)"
  description="Sẵn sàng cho các vị trí kỹ thuật dữ liệu, kỹ thuật ML và khoa học dữ liệu toàn thời gian. Đặt tại New York."
  lang={lang}
>

  <section class="page-hero section section--dark">
    <div class="container">
      <span class="program-label">Liên Hệ</span>
      <h1>{t.headline}</h1>
      <p class="page-sub">{t.body}</p>
    </div>
  </section>

  <Waveform bars={60} class="section-waveform" />

  <section class="section section--cream">
    <div class="container container--narrow">

      <div class="contact-links">
        <a href="mailto:ngocrubytin@gmail.com" class="contact-link">
          <span class="cl-label">{t.email_label}</span>
          <span class="cl-value">ngocrubytin@gmail.com</span>
          <span class="cl-arrow" aria-hidden="true">→</span>
        </a>

        <a href="https://www.linkedin.com/in/ngocrubyngo" class="contact-link" target="_blank" rel="noopener">
          <span class="cl-label">{t.linkedin_label}</span>
          <span class="cl-value">linkedin.com/in/ngocrubyngo</span>
          <span class="cl-arrow" aria-hidden="true">→</span>
        </a>

        <a href={`/resume.pdf`} class="contact-link" target="_blank" rel="noopener">
          <span class="cl-label">{t.resume_label}</span>
          <span class="cl-value">Tải PDF</span>
          <span class="cl-arrow" aria-hidden="true">→</span>
        </a>
      </div>

      <div class="waveform-divider waveform-animated" style="margin-block: var(--space-12);" aria-hidden="true"></div>

      <div class="contact-note">
        <span class="program-label">Một lưu ý</span>
        <p>Tôi phản hồi những liên hệ chân thành và cụ thể — đặc biệt từ những nhóm đang làm việc thú vị tại giao điểm giữa hệ thống và ý nghĩa. Nếu bạn đang xây dựng điều gì đó mà bạn muốn giải thích cho khán giả tại nhà hát hòa nhạc, tôi sẵn lòng lắng nghe.</p>
      </div>

    </div>
  </section>

</BaseLayout>

<style>
.page-hero { padding-top: 120px; }
.page-sub { color: rgba(245,240,232,0.65); margin-top: var(--space-3); font-style: italic; font-size: var(--text-lg); max-width: 52ch; }
.section-waveform { background: var(--color-hall-black); padding: var(--space-3) var(--space-8); }

.contact-links {
  display: flex;
  flex-direction: column;
  gap: 0;
  border-top: 1px solid var(--color-cream-mid);
}

.contact-link {
  display: grid;
  grid-template-columns: 120px 1fr auto;
  align-items: center;
  gap: var(--space-6);
  padding: var(--space-6) 0;
  border-bottom: 1px solid var(--color-cream-mid);
  transition: background var(--transition);
  border-radius: 0;
}
.contact-link:hover { background: transparent; }
.contact-link:hover .cl-arrow { transform: translateX(4px); }

.cl-label {
  font-size: var(--text-xs);
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--color-text-muted);
  font-family: var(--font-sans);
}

.cl-value {
  font-family: var(--font-serif);
  font-size: clamp(var(--text-xl), 2.5vw, var(--text-3xl));
  font-weight: 300;
  letter-spacing: -0.01em;
  color: var(--color-text-dark);
}

.cl-arrow {
  font-size: var(--text-2xl);
  color: var(--color-pearl);
  transition: transform var(--transition);
}

.contact-note p {
  font-size: var(--text-lg);
  font-style: italic;
  color: var(--color-text-muted);
  line-height: 1.75;
  max-width: none;
}

@media (max-width: 640px) {
  .contact-link {
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
  }
  .cl-label { grid-column: 1; }
  .cl-value { grid-column: 1; }
  .cl-arrow { grid-row: 1 / 3; grid-column: 2; align-self: center; }
}
</style>
