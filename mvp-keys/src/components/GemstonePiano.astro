---
/*
  GemstonePiano — practice heatmap mapped onto the same one-octave visual.
  Algorithm: days are distributed across 13 keys by (day-of-month - 1) mod 13.
  Keys with practice data glow gemstone blue.
  Toggle: parent page swaps between GemstoneGrid and GemstonePiano via tab UI.
*/

interface PracticeEntry { minutes?: number; piece?: string; note?: string; }
interface Props { log: Record<string, PracticeEntry>; }

const { log } = Astro.props;

const KEY_NOTES = ['C4','C#4','D4','D#4','E4','F4','F#4','G4','G#4','A4','A#4','B4','C5'];
const KEY_LABELS = ['C','C♯','D','D♯','E','F','F♯','G','G♯','A','A♯','B','C'];
const IS_BLACK   = [false,true,false,true,false,false,true,false,true,false,true,false,false];

// Map each practice session to a key index by (day-of-month - 1) mod 13
const keyData: { sessions: { date: string; minutes?: number; piece?: string }[]; totalMins: number }[] =
  KEY_NOTES.map(() => ({ sessions: [], totalMins: 0 }));

Object.entries(log).forEach(([date, entry]) => {
  if (date.startsWith('_')) return;
  const dayOfMonth = parseInt(date.split('-')[2], 10);
  const idx = (dayOfMonth - 1) % 13;
  keyData[idx].sessions.push({ date, ...entry });
  keyData[idx].totalMins += entry.minutes ?? 0;
});

const maxMins = Math.max(...keyData.map(k => k.totalMins), 1);
---

<div class="gp-wrapper" aria-label="Piano practice heatmap">
  <p class="gp-legend-note">
    Keys glow based on practice sessions mapped by day of month (mod 13). Brighter = more time.
  </p>

  <div class="gp-piano" role="img" aria-label="One-octave piano with practice intensity">
    <!-- White keys -->
    <div class="gp-white-keys">
      {KEY_NOTES.map((note, i) => {
        if (IS_BLACK[i]) return null;
        const intensity = keyData[i].totalMins / maxMins;
        return (
          <div
            class:list={['gp-key', 'gp-key--white', { 'gp-key--active': keyData[i].sessions.length > 0 }]}
            style={`--intensity: ${intensity}`}
            title={`${note}: ${keyData[i].sessions.length} sessions, ${Math.round(keyData[i].totalMins / 60 * 10) / 10}h`}
            aria-label={`${note}: ${keyData[i].sessions.length} practice sessions`}
            role="img"
          >
            <span class="gp-key-label" aria-hidden="true">{KEY_LABELS[i]}</span>
          </div>
        );
      })}
    </div>

    <!-- Black keys (positioned absolutely) -->
    <div class="gp-black-keys" aria-hidden="true">
      {KEY_NOTES.map((note, i) => {
        if (!IS_BLACK[i]) return null;
        const blackIndex = [1,3,6,8,10].indexOf(i);
        const intensity = keyData[i].totalMins / maxMins;
        return (
          <div
            class:list={['gp-key', 'gp-key--black', `gp-key--black-${blackIndex}`, { 'gp-key--active': keyData[i].sessions.length > 0 }]}
            style={`--intensity: ${intensity}`}
            title={`${note}: ${keyData[i].sessions.length} sessions, ${Math.round(keyData[i].totalMins / 60 * 10) / 10}h`}
          >
            <span class="gp-key-label-b">{KEY_LABELS[i]}</span>
          </div>
        );
      })}
    </div>
  </div>

  <!-- Accessible summary -->
  <ul class="gp-summary-list" aria-label="Key practice summary">
    {KEY_NOTES.map((note, i) => keyData[i].sessions.length > 0 && (
      <li>
        <strong>{note}</strong>: {keyData[i].sessions.length} sessions,{' '}
        {Math.round(keyData[i].totalMins / 60 * 10) / 10}h
        {keyData[i].sessions[0]?.piece && ` — e.g. ${keyData[i].sessions[0].piece}`}
      </li>
    ))}
  </ul>
</div>

<style>
.gp-wrapper { font-family: var(--font-sans); }

.gp-legend-note {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  margin-bottom: var(--space-4);
  max-width: none;
}

.gp-piano {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  width: max-content;
}

.gp-white-keys {
  display: flex;
  gap: 3px;
  position: relative;
  z-index: 1;
}

.gp-key--white {
  width: 56px;
  height: 160px;
  background: rgba(245,240,232,0.9);
  border: 1.5px solid rgba(10,10,10,0.15);
  border-radius: 0 0 var(--radius-md) var(--radius-md);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: var(--space-2);
  box-shadow: 0 3px 8px rgba(0,0,0,0.2);
  position: relative;
  overflow: hidden;
  transition: box-shadow 0.3s;
}

.gp-key--white.gp-key--active {
  background: color-mix(in srgb, var(--color-pearl) calc(var(--intensity, 0) * 60%), rgba(245,240,232,0.9));
  box-shadow:
    0 0 calc(var(--intensity, 0) * 20px) var(--color-pearl-dim),
    0 0 calc(var(--intensity, 0) * 40px) var(--color-pearl-glow),
    0 3px 8px rgba(0,0,0,0.2);
}

@keyframes gem-glow-white {
  0%, 100% { box-shadow: 0 0 8px var(--color-pearl-dim), 0 3px 8px rgba(0,0,0,0.2); }
  50%       { box-shadow: 0 0 20px var(--color-pearl), 0 0 40px var(--color-pearl-glow), 0 3px 8px rgba(0,0,0,0.2); }
}

.gp-key--white.gp-key--active {
  animation: gem-glow-white 2.8s ease-in-out infinite;
}

.gp-key-label {
  font-size: var(--text-xs);
  font-weight: 600;
  color: rgba(10,10,10,0.35);
  letter-spacing: 0.04em;
}

.gp-black-keys {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 104px;
  z-index: 2;
  pointer-events: none;
}

.gp-key--black {
  position: absolute;
  width: 36px;
  height: 104px;
  background: var(--color-hall-black);
  border: 1.5px solid rgba(245,240,232,0.06);
  border-radius: 0 0 var(--radius-sm) var(--radius-sm);
  box-shadow: 2px 4px 12px rgba(0,0,0,0.5);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: var(--space-2);
  overflow: hidden;
}

.gp-key--black.gp-key--active {
  background: color-mix(in srgb, var(--color-pearl) calc(var(--intensity, 0) * 70%), var(--color-hall-black));
  box-shadow:
    0 0 calc(var(--intensity, 0) * 16px) var(--color-pearl),
    0 0 calc(var(--intensity, 0) * 30px) var(--color-pearl-glow),
    2px 4px 12px rgba(0,0,0,0.5);
}

@keyframes gem-glow-black {
  0%, 100% { box-shadow: 0 0 6px var(--color-pearl-dim), 2px 4px 12px rgba(0,0,0,0.5); }
  50%       { box-shadow: 0 0 18px var(--color-pearl), 0 0 32px var(--color-pearl-glow), 2px 4px 12px rgba(0,0,0,0.5); }
}

.gp-key--black.gp-key--active {
  animation: gem-glow-black 2.8s ease-in-out infinite;
}

.gp-key-label-b {
  font-size: 9px;
  color: rgba(245,240,232,0.3);
  letter-spacing: 0.03em;
}

/* Black key positions: same proportional layout as PianoHero but scaled to 56px white keys */
.gp-key--black-0 { left: calc(0 * 59px + 36px); }
.gp-key--black-1 { left: calc(1 * 59px + 36px); }
.gp-key--black-2 { left: calc(3 * 59px + 36px); }
.gp-key--black-3 { left: calc(4 * 59px + 36px); }
.gp-key--black-4 { left: calc(5 * 59px + 36px); }

.gp-summary-list {
  margin-top: var(--space-4);
  list-style: none;
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
}

@media (prefers-reduced-motion: reduce) {
  .gp-key--white.gp-key--active,
  .gp-key--black.gp-key--active { animation: none; }
}

@media (max-width: 600px) {
  .gp-key--white { width: 38px; height: 120px; }
  .gp-key--black { width: 26px; height: 78px; }
  .gp-black-keys { height: 78px; }
  .gp-key--black-0 { left: calc(0 * 41px + 25px); }
  .gp-key--black-1 { left: calc(1 * 41px + 25px); }
  .gp-key--black-2 { left: calc(3 * 41px + 25px); }
  .gp-key--black-3 { left: calc(4 * 41px + 25px); }
  .gp-key--black-4 { left: calc(5 * 41px + 25px); }
}
</style>
