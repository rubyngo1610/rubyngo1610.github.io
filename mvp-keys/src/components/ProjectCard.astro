---
interface Props {
  id: string;
  title: string;
  subtitle: string;
  narrative: string;
  tags: string[];
  repo?: string | null;
  dark?: boolean;
  lang?: 'en' | 'vi';
  hasModal?: boolean;
}

const { id, title, subtitle, narrative, tags, repo, dark = false, lang = 'en', hasModal = false } = Astro.props;
---

<article
  class:list={['project-card', { 'project-card--dark': dark, 'project-card--clickable': hasModal }]}
  data-modal-id={hasModal ? `modal-${id}` : undefined}
  role={hasModal ? 'button' : 'article'}
  tabindex={hasModal ? 0 : undefined}
  aria-haspopup={hasModal ? 'dialog' : undefined}
>
  <header class="pc-header">
    <p class="pc-subtitle">{subtitle}</p>
    <h3 class="pc-title">{title}</h3>
  </header>
  <p class="pc-narrative">{narrative}</p>
  <footer class="pc-footer">
    <div class="pc-tags" aria-label="Technologies">
      {tags.map(tag => <span class="tag">{tag}</span>)}
    </div>
    <div class="pc-actions">
      {hasModal && (
        <span class="pc-read-more" aria-hidden="true">
          Read more →
        </span>
      )}
      {repo && !hasModal && (
        <a href={repo} class="pc-repo-link" target="_blank" rel="noopener noreferrer" aria-label={`View ${title} on GitHub`} onclick="event.stopPropagation()">
          {lang === 'vi' ? 'Xem mã nguồn' : 'View repo'} →
        </a>
      )}
    </div>
  </footer>
</article>

<style>
.pc-header { margin-bottom: var(--space-4); }

.pc-subtitle {
  font-family: var(--font-sans);
  font-size: var(--text-xs);
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-pearl);
  margin-bottom: var(--space-1);
}

.project-card--dark .pc-subtitle {
  color: var(--color-mermaid);
}

.pc-title {
  font-family: var(--font-serif);
  font-size: var(--text-2xl);
  font-weight: 400;
  letter-spacing: -0.02em;
  line-height: 1.2;
}

.pc-narrative {
  font-size: var(--text-base);
  line-height: 1.7;
  color: var(--color-text-muted);
  font-style: italic;
  margin-bottom: var(--space-6);
}

.project-card--dark .pc-narrative {
  color: rgba(245,240,232,0.6);
}

.pc-footer {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--space-3);
  justify-content: space-between;
}

.pc-tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.project-card--dark .tag {
  background: rgba(245,240,232,0.1);
  color: var(--color-mermaid);
}

.pc-actions { display: flex; align-items: center; gap: var(--space-3); }

.pc-repo-link, .pc-read-more {
  font-size: var(--text-sm);
  font-weight: 500;
  color: var(--color-pearl);
  letter-spacing: 0.02em;
  white-space: nowrap;
  transition: color var(--transition);
}
.pc-repo-link { text-decoration: none; }
.pc-repo-link:hover, .pc-read-more:hover { color: var(--color-mermaid); }

/* Clickable card */
.project-card--clickable {
  cursor: pointer;
  transition: transform 0.2s var(--ease-out), box-shadow 0.2s var(--ease-out);
}

.project-card--clickable:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 32px rgba(0,0,0,0.08);
}

.project-card--clickable:focus-visible {
  outline: 2px solid var(--color-pearl);
  outline-offset: 4px;
  border-radius: var(--radius-md);
}

.project-card--dark.project-card--clickable:hover {
  box-shadow: 0 8px 32px rgba(0,0,0,0.3);
}
</style>

<script>
document.querySelectorAll('.project-card--clickable').forEach(card => {
  const modalId = card.getAttribute('data-modal-id');
  if (!modalId) return;

  const open = () => {
    const modal = document.getElementById(modalId) as HTMLDialogElement | null;
    modal?.showModal();
  };

  card.addEventListener('click', open);
  card.addEventListener('keydown', (e) => {
    if ((e as KeyboardEvent).key === 'Enter' || (e as KeyboardEvent).key === ' ') {
      e.preventDefault();
      open();
    }
  });
});
</script>
